{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dotcomseekr-discovery-trial",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "dotcomseekr-discovery-trial",
      "database_id": "f80f2cae-70b0-47e7-81e2-b507732088d9"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "TRIAL_PROVIDER": "workers-ai",
    "TRIAL_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "TRIAL_ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://dotcomseekr-discovery-trial-web.mike-f16.workers.dev",
    "TRIAL_SESSION_TURNS_PER_DAY": "10",
    "TRIAL_SESSION_CALLS_PER_DAY": "18",
    "TRIAL_GLOBAL_TURNS_PER_DAY": "80",
    "TRIAL_GLOBAL_CALLS_PER_DAY": "100",
    "TRIAL_TOTAL_TURNS": "150",
    "TRIAL_TOTAL_CALLS": "250",
    "TRIAL_TOTAL_TOKENS": "400000",
    "SOURCE_SHA": "set-at-deploy",
    "DEPLOYMENT_VERSION": "set-at-deploy"
  }
}
